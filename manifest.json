{
  "name": "Kauppisen perhekalenteri",
  "short_name": "Kalenteri",
  "description": "Perheen yhteinen kalenteri ja tehtävälista",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "background_color": "#f2f4f7",
  "theme_color": "#f2f4f7",
  "orientation": "portrait-primary",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    {
      "src": "logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Uusi tapahtuma",
      "short_name": "Lisää",
      "url": "./index.html?uusi=1",
      "icons": [{ "src": "logo.png", "sizes": "192x192" }]
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html?tuonti=ics",
      "accept": {
        "text/calendar": [".ics", ".vcs"],
        "application/ics": [".ics"],
        "text/x-vcalendar": [".vcs"]
      },
      "icons": [{ "src": "logo.png", "sizes": "192x192" }],
      "launch_type": "single-client"
    }
  ]
}
